 &lt;/div&gt;
&lt;/div&gt;
&lt;div class="step"&gt;
 &lt;div class="step__marker"&gt;&lt;/div&gt;
 &lt;div class="step__body"&gt;
 &lt;div class="step__title"&gt;deploy_staging&lt;/div&gt;
