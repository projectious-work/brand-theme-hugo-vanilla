[
{{- $pages := sort (where site.RegularPages "Type" "not in" (slice "search")) "RelPermalink" -}}
{{- range $i, $p := $pages -}}
  {{- $record := partial "page-record.html" $p -}}
  {{ if $i }},{{ end }}
  {
    "id": {{ $record.id | jsonify }},
    "title": {{ $record.title | jsonify }},
    "url": {{ $record.relativeUrl | jsonify }},
    "section": {{ $record.section | jsonify }},
    "description": {{ $record.description | jsonify }},
    "language": {{ $record.language | jsonify }},
    "tags": {{ $record.tags | jsonify }},
    "content": {{ $record.content | jsonify }}
  }
{{- end -}}
]
